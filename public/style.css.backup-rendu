.brand img{width:100px;height:42px;object-fit:contain;display:block}

.brand img{width:150px;height:65px;object-fit:contain;display:block}
/* =========================================
   WEAZEL NEWS — NEWSROOM
========================================= */

.newsroom-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin: 35px 0 22px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(255,255,255,.12);
}

.newsroom-kicker {
    display: block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: .65;
    margin-bottom: 5px;
}

.newsroom-header h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 900;
}

.newsroom-header p {
    margin: 7px 0 0;
    opacity: .65;
}

.newsroom-count {
    white-space: nowrap;
    padding: 7px 12px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
}

.newsroom-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.newsroom-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: transform .2s ease, box-shadow .2s ease;
}

.newsroom-card:hover {
    transform: translateY(-4px);
}

.newsroom-image {
    position: relative;
    display: block;
    width: 100%;
    height: 210px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-color: #1b1b1b;
}

.newsroom-image:not([style]) {
    background-image: linear-gradient(
        135deg,
        #222,
        #111
    );
}

.breaking-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 10px;
    border-radius: 4px;
    background: #d71920;
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .5px;
}

.newsroom-card .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px;
}

.newsroom-card label {
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: .65;
}

.newsroom-card h3 {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.25;
}

.newsroom-card p {
    margin: 0 0 15px;
    line-height: 1.55;
    opacity: .72;
}

.newsroom-meta {
    display: flex;
    gap: 15px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 12px;
    opacity: .55;
}

.newsroom-card .read {
    display: inline-block;
    margin-top: 14px;
    font-weight: 800;
    text-decoration: none;
}

.newsroom-card .read:hover {
    text-decoration: underline;
}

.newsroom-card.isbreaking {
    border-color: rgba(215,25,32,.6);
}

.empty-newsroom {
    padding: 45px 20px;
    text-align: center;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 10px;
}

.empty-newsroom h3 {
    margin: 0 0 8px;
}

.empty-newsroom p {
    margin: 0;
    opacity: .6;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1000px) {

    .newsroom-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}

@media (max-width: 650px) {

    .newsroom-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .newsroom-header h2 {
        font-size: 26px;
    }

    .newsroom-grid {
        grid-template-columns: 1fr;
    }

    .newsroom-image {
        height: 220px;
    }

}
/* ===== IMAGES DES ARTICLES ===== */

.articlehead img {
    display: block;
    width: 100%;
    max-width: 1100px;
    height: 520px;
    object-fit: cover;
    object-position: center;
    margin: 25px auto;
    border-radius: 14px;
}

/* Image dans les cartes d'actualités */
.newsroom-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    object-position: center;
    display: block;
}

/* Adaptation mobile */
@media (max-width: 768px) {
    .articlehead img {
        width: 100%;
        height: 300px;
        margin: 18px auto;
        border-radius: 10px;
    }

    .newsroom-image {
        height: 220px;
    }
}
/* ===== PAGE ARTICLE - STYLE PRESSE ===== */

.article-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 35px 25px 70px;
}

.article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: start;
}

.article-main {
    min-width: 0;
}

.articlehead {
    margin-bottom: 25px;
}

.articlehead label {
    display: inline-block;
    color: #e30613;
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.articlehead h1 {
    font-size: 42px;
    line-height: 1.12;
    margin: 0 0 15px;
    font-weight: 800;
}

.articlehead .meta {
    color: #666;
    font-size: 15px;
    margin-bottom: 20px;
}

/* IMAGE PRINCIPALE : AFFICHAGE COMPLET */
.articlehead > img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
    object-position: center;
    margin: 25px 0;
    border-radius: 10px;
    background: #f2f2f2;
}

/* CONTENU */
.article-main .content {
    font-size: 18px;
    line-height: 1.75;
    color: #222;
}

/* RÉACTIONS */
.reactions {
    display: flex;
    gap: 10px;
    margin: 30px 0;
    flex-wrap: wrap;
}

.reaction-btn {
    border: 1px solid #ddd;
    background: white;
    border-radius: 10px;
    padding: 9px 14px;
    cursor: pointer;
    font-size: 18px;
    transition: .2s;
}

.reaction-btn:hover {
    transform: translateY(-2px);
    border-color: #e30613;
    box-shadow: 0 4px 12px rgba(0,0,0,.08);
}

.reaction-btn strong {
    margin-left: 5px;
    font-size: 14px;
}

/* ===== DERNIÈRES ACTUALITÉS ===== */

.article-sidebar {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    padding: 22px;
    position: sticky;
    top: 25px;
}

.article-sidebar h2 {
    font-size: 22px;
    margin: 0 0 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid #ddd;
}

.article-sidebar h2::after {
    content: "";
    display: block;
    width: 55px;
    height: 3px;
    background: #e30613;
    margin-top: 12px;
}

.latest-article {
    display: grid;
    grid-template-columns: 115px 1fr;
    gap: 13px;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
}

.latest-article:last-child {
    border-bottom: 0;
}

.latest-article img {
    width: 115px;
    height: 85px;
    object-fit: cover;
    border-radius: 5px;
}

.latest-article h3 {
    font-size: 15px;
    line-height: 1.35;
    margin: 0 0 8px;
}

.latest-article small {
    color: #777;
    font-size: 12px;
}

/* ===== MOBILE ===== */

@media (max-width: 900px) {

    .article-layout {
        grid-template-columns: 1fr;
    }

    .article-sidebar {
        position: static;
    }

    .articlehead h1 {
        font-size: 32px;
    }

    .articlehead > img {
        max-height: none;
    }
}

@media (max-width: 600px) {

    .article-page {
        padding: 20px 15px 50px;
    }

    .articlehead h1 {
        font-size: 27px;
    }

    .articlehead > img {
        width: 100%;
        height: auto;
        border-radius: 7px;
    }

    .latest-article {
        grid-template-columns: 95px 1fr;
    }

    .latest-article img {
        width: 95px;
        height: 70px;
    }
}